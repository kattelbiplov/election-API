NODE_ENV=development
PORT=4000

# Local dev DB — matches docker-compose.yml
DATABASE_URL=postgresql://election:election_dev_password@localhost:5435/election_platform?schema=public

# Generate real secrets with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

BCRYPT_SALT_ROUNDS=12
